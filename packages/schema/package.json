{
  "name": "@actionmanifest/schema",
  "version": "0.1.0",
  "description": "Language-neutral Action Manifest JSON Schemas (immutable, versioned: v0.1, v0.2) and TypeScript types.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/v0.1/action-manifest.schema.json": "./schemas/v0.1/action-manifest.schema.json",
    "./schemas/v0.2/action-manifest.schema.json": "./schemas/v0.2/action-manifest.schema.json",
    "./schemas/canonical-document.schema.json": "./schemas/canonical-document.schema.json"
  },
  "files": ["dist", "schemas"],
  "scripts": {
    "build": "tsc -b"
  }
}
