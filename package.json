{
  "name": "action-manifest",
  "private": true,
  "version": "0.1.0",
  "description": "Turn documents into actions you can verify.",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --filter \"./apps/*\" run build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty && pnpm --filter @actionmanifest/reference-consumer run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "schema:validate": "tsx scripts/validate-schema.ts",
    "benchmark": "tsx apps/cli/src/index.ts benchmark",
    "benchmark:smoke": "tsx apps/cli/src/index.ts benchmark --smoke",
    "integration:test": "pnpm build && vitest run --config integration/vitest.config.ts",
    "pack:check": "pnpm build && tsx scripts/pack-check.ts",
    "actionman": "tsx apps/cli/src/index.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^22.18.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.35.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0",
    "vitest": "^3.2.4"
  }
}
