{
  "name": "@actionmanifest/schema",
  "version": "0.1.0",
  "description": "Language-neutral Action Manifest JSON Schema v0.1 and TypeScript types.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./action-manifest.schema.json": "./src/action-manifest.schema.json",
    "./canonical-document.schema.json": "./src/canonical-document.schema.json"
  },
  "files": ["dist", "src/*.json"],
  "scripts": {
    "build": "tsc -b"
  }
}
