{
  "name": "@actionmanifest/cli",
  "version": "0.1.0",
  "description": "actionman CLI — extract, validate, benchmark, and check conformance of Action Manifests.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "actionman": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "conformance",
    "benchmark",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-ai-company/ActionManifest.git",
    "directory": "apps/cli"
  },
  "homepage": "https://github.com/hello-ai-company/ActionManifest/tree/main/apps/cli#readme",
  "bugs": "https://github.com/hello-ai-company/ActionManifest/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "start": "tsx src/index.ts",
    "prepack": "node ../../scripts/pack-assets.mjs copy conformance benchmark",
    "postpack": "node ../../scripts/pack-assets.mjs clean conformance benchmark"
  },
  "dependencies": {
    "@actionmanifest/adapters": "workspace:*",
    "@actionmanifest/core": "workspace:*",
    "@actionmanifest/extractor": "workspace:*",
    "@actionmanifest/exporters": "workspace:*",
    "@actionmanifest/verifier": "workspace:*",
    "commander": "^14.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  }
}
