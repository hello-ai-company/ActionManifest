{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "Node16",
    "moduleResolution": "Node16",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": "../..",
    "paths": {
      "@actionmanifest/schema": ["packages/schema/src/index.ts"],
      "@actionmanifest/core": ["packages/core/src/index.ts"],
      "@actionmanifest/adapters": ["packages/adapters/src/index.ts"],
      "@actionmanifest/temporal": ["packages/temporal/src/index.ts"],
      "@actionmanifest/extractor": ["packages/extractor/src/index.ts"],
      "@actionmanifest/verifier": ["packages/verifier/src/index.ts"],
      "@actionmanifest/exporters": ["packages/exporters/src/index.ts"],
      "@actionmanifest/consumer": ["packages/consumer/src/index.ts"],
      "@actionmanifest/adapter-xberg": ["packages/adapter-xberg/src/index.ts"]
    }
  },
  "include": ["*.ts"]
}
