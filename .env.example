# OpenAI-compatible provider (optional — CI uses the mock/deterministic provider)
# Never commit real keys. Source text is sent to this endpoint only when you run
# `actionman extract` with --provider openai (or ACTIONMAN_PROVIDER=openai).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ACTIONMAN_MODEL=gpt-4o-mini

# Provider timeout in milliseconds (default 30000)
ACTIONMAN_TIMEOUT_MS=30000

# Max LLM retries on malformed JSON (default 0 — fail closed, no silent fallback)
ACTIONMAN_MAX_RETRIES=0
