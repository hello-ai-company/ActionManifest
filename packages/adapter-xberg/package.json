{
  "name": "@actionmanifest/adapter-xberg",
  "version": "0.1.0",
  "description": "Xberg reference adapter: Xberg ExtractionResult → CanonicalDocument. The native Xberg dependency is isolated in this package; ActionManifest Core stays parser-free.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-ai-company/ActionManifest.git",
    "directory": "packages/adapter-xberg"
  },
  "homepage": "https://github.com/hello-ai-company/ActionManifest/tree/main/packages/adapter-xberg#readme",
  "bugs": "https://github.com/hello-ai-company/ActionManifest/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/pack-assets.mjs copy",
    "postpack": "node ../../scripts/pack-assets.mjs clean"
  },
  "dependencies": {
    "@actionmanifest/adapters": "workspace:*",
    "@actionmanifest/core": "workspace:*",
    "@xberg-io/xberg": "1.1.3"
  }
}
