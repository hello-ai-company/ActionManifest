{
  "name": "@actionmanifest/adapters",
  "version": "0.1.0",
  "description": "Document adapters: Plain Text (working) and Docling (interface + fixtures).",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hello-ai-company/ActionManifest.git",
    "directory": "packages/adapters"
  },
  "homepage": "https://github.com/hello-ai-company/ActionManifest/tree/main/packages/adapters#readme",
  "bugs": "https://github.com/hello-ai-company/ActionManifest/issues",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -b",
    "prepack": "node ../../scripts/pack-assets.mjs copy",
    "postpack": "node ../../scripts/pack-assets.mjs clean"
  },
  "dependencies": {
    "@actionmanifest/core": "workspace:*"
  }
}
